// Search discovery is performed by Hermes; Python never calls an LLM.
// Vendor queries follow kobyal/ai-latest-briefing at commit 22774b5.
{
  "timezone": "Asia/Hong_Kong",
  "request_delay_seconds": 2.0,
  "detail_budget": 10,
  "lookback_days": 1,
  "cluster_threshold": 0.7,
  "categories": [
    { "name": "ai", "label": "AI" },
    { "name": "community", "label": "Community Pulse" }
  ],
  "exclude": ["sponsored", "advertisement", "newsletter signup"],
  "sources": [
    {
      "name": "github-copilot", "category": "ai", "kind": "rss",
      "url": "https://github.blog/changelog/label/copilot/feed/", "max_items": 15
    },
    {
      "name": "anthropic", "category": "ai", "kind": "search",
      "url": "https://www.anthropic.com/news",
      "query": "Anthropic Claude latest news {month_year}", "max_items": 10
    },
    {
      "name": "openai", "category": "ai", "kind": "search",
      "url": "https://openai.com/news/",
      "query": "OpenAI latest release {month_year}", "max_items": 10
    },
    {
      "name": "google", "category": "ai", "kind": "search",
      "url": "https://blog.google/technology/ai/",
      "query": "Google Gemini AI latest update {month_year}", "max_items": 10
    },
    {
      "name": "azure", "category": "ai", "kind": "search",
      "url": "https://azure.microsoft.com/en-us/blog/",
      "query": "Microsoft Azure OpenAI latest announcement {month_year}", "max_items": 10
    },
    {
      "name": "hacker-news", "category": "community", "kind": "search",
      "url": "https://news.ycombinator.com/",
      "query": "site:news.ycombinator.com {topic} {today}", "max_items": 5
    },
    {
      "name": "reddit", "category": "community", "kind": "search",
      "url": "https://www.reddit.com/r/LocalLLaMA/",
      "query": "site:reddit.com/r/MachineLearning OR site:reddit.com/r/LocalLLaMA {topic} {today}",
      "max_items": 5
    }
  ]
}
