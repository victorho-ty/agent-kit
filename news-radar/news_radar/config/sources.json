// Every source needs a "category", and that category must be declared in the
// "categories" list below. The order of that list is the order of sections in
// the digest -- put what matters to you first.
//
// A source is not trusted until it has been checked against the live feed:
//     news-radar scan --source <name> --dry-run
//
// Field reference: skills/news-radar/references/source-config.md
{
  "timezone": "Asia/Hong_Kong",
  "request_delay_seconds": 2.0,
  "detail_budget": 10,
  "cluster_threshold": 0.7,

  "categories": [
    { "name": "ai",    "label": "AI" },
    { "name": "equities",  "label": "Equities" },
    { "name": "finance", "label": "Finance" },
    { "name": "tech",  "label": "Technology" }
  ],

// Dropped outright, whatever else the item says.
  "exclude": ["sponsored", "advertisement", "newsletter signup"],

  "sources": [
    {
      "name": "github-copilot",
      "category": "ai",
      "url": "https://github.blog/changelog/label/copilot/feed/",
      "kind": "rss",
      "max_items": 30,
      "enabled": true
    },
//    llm-news -- VERIFIED 2026-08-11, and the awkward one. Read this before
//    changing it.
//
//    The page is a Next.js app that ships no news markup at all in its HTML
//    response, so it needs "render": "browser". That costs a Chromium start
//    per scan and forfeits conditional GET, which is why min_interval_minutes
//    is set: there is no point paying that every hour for a page that turns
//    over a few times a day.
//
//    Its items are <button> elements with NO href anywhere, so nothing here
//    can give a per-story link -- every item is stored against the page URL
//    and the digest will link to the section rather than the article. That is
//    a real limitation of this source, not a misconfiguration.
//
//    The selector leans on Tailwind spacing classes because the page offers
//    nothing else; #llm-news is an id and is stable, div.space-y-3 is not. If
//    the layout is retuned this goes zero_yield, which is the designed
//    outcome -- you will be told rather than quietly getting nothing.
//
//    There is deliberately no "date" field. The page prints relative times
//    ("51m ago"), and date_text is stored verbatim and never recomputed, so an
//    item captured at 09:00 would still claim "51m ago" in the 18:00 digest.
//    A stale relative time is worse than no time at all. first_seen_at is on
//    the record if you want to know when the radar saw it.
//    The selector, if you disagree and want it anyway: "date": "span.tabular-nums"
    {
      "name": "llm-news",
      "category": "ai",
      "url": "https://llm-stats.com/ai-news",
      "kind": "html",
      "render": "browser",
      "list_selector": "#llm-news div.space-y-3 > div",
      "fields": {
        "title": "h3",
        "summary": "p"
      },
      "min_interval_minutes": 180,
      "max_items": 30,
      "enabled": true
    }

//    A source that should not be hit as often as the rest. min_interval_minutes
//    is a floor, not a schedule: the hourly cron still runs, and this source is
//    reported as "throttled" and skipped until its floor has passed. Use it for
//    slow personal blogs and for anything with "render": "browser".
//    {
//      "name": "slow-blog",
//      "category": "ai",
//      "url": "https://example.dev/feed",
//      "kind": "rss",
//      "min_interval_minutes": 360,
//      "enabled": false
//    },
//    An outlet with no feed. Selectors are a last resort -- they break on a
//    redesign, which a feed cannot. Verify with --dry-run before enabling.
//    {
//      "name": "example-outlet",
//      "category": "world",
//      "url": "https://news.example.com/latest",
//      "kind": "html",
//      "render": "static",
//      "list_selector": "article.story",
//      "fields": {
//        "title": "h2 a",
//        "link": "h2 a@href",
//        "summary": "p.standfirst",
//        "date": "time"
//      },
//      "max_items": 25,
//      "enabled": false
//    }
  ]
}
